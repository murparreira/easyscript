{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "easyscript",
  "identifier": "com.busyboys.easyscript",
  "build": {
    "beforeDevCommand": "npm run dev -w app/ui",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build -w app/ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "easyscript",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
